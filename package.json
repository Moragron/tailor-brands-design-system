{
  "name": "tailor-brands-design-system",
  "version": "0.3.1",
  "private": true,
  "description": "Tailor Brands design system for Lovable: design tokens + content-free React components, styled for Tailwind 4 (Tailwind 3 preset included). Bring your own copy.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moragron/tailor-brands-design-system.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tokens:css": "node scripts/build-tokens-css.mjs",
    "tokens:check": "node scripts/build-tokens-css.mjs && git diff --exit-code -- src/styles",
    "lovable:sync": "node scripts/sync-lovable.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "research:storybook": "storybook dev -c research/.storybook -p 6007",
    "research:build-storybook": "storybook build -c research/.storybook -o research/storybook-static",
    "research:capture": "node research/scripts/capture.mjs",
    "research:tokens": "node research/scripts/derive-tokens.mjs",
    "research:qa": "node research/scripts/visual-qa.mjs",
    "research:selftest": "node research/scripts/selftest-pipeline.mjs"
  },
  "dependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
